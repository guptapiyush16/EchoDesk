# Server-only Google Gemini & SerpAPI configuration.
# Never use VITE_* for secrets; VITE values are shipped to the browser.
PORT=8787
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
SESSION_SECRET=replace-with-a-long-random-server-secret
# Exact frontend origin(s), comma-separated:
APP_ORIGIN=https://your-domain.example
SERPAPI_API_KEY=
# Optional alternate provider endpoint:
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
